# ----------------------------------
# WordPress Plugin Repository Setup
# Only track: wp-content/plugins/wp-maintenance-lite
# Ignore everything else
# ----------------------------------

# Ignore entire wp-content folder
/wp-content/

# Whitelist plugins folder
!/wp-content/plugins/

# Whitelist your plugin
!/wp-content/plugins/wp-maintenance-lite/

# Ignore uploads, themes, other plugins, cache, etc
/wp-content/uploads/
/wp-content/themes/
/wp-content/plugins/*

# But keep your plugin again (overrides previous ignore)
/wp-content/plugins/wp-maintenance-lite/

# Ignore WP core
/wp-admin/
/wp-includes/
/index.php
/license.txt
/readme.html
/xmlrpc.php
/wp-*.php

# Ignore config
wp-config.php

# Ignore logs
*.log

# Ignore system files
.DS_Store
Thumbs.db

# Ignore htaccess
/.htaccess
